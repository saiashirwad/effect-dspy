{
  "$schema": "https://dprint.dev/schemas/v0.json",
  "lineWidth": 100,
  "indentWidth": 2,
  "newLineKind": "lf",
  "typescript": {
    "semiColons": "asi",
    "quoteStyle": "alwaysDouble",
    "trailingCommas": "never"
  },
  "json": {},
  "markdown": {},
  "includes": ["**/*.{ts,tsx,js,mjs,cjs,json,jsonc,md}"],
  "excludes": [
    "**/node_modules",
    "**/dist",
    "**/dist-examples",
    "**/coverage",
    "package-lock.json",
    "tools/oxlint/anti-slop/**",
    ".agent/**",
    ".agents/**",
    ".claude/**",
    ".codex/**",
    ".continue/**",
    ".cursor/**",
    ".gemini/**",
    ".opencode/**",
    ".pi/**",
    ".roo/**",
    ".windsurf/**"
  ],
  "plugins": [
    "https://plugins.dprint.dev/typescript-0.96.1.wasm",
    "https://plugins.dprint.dev/json-0.25.0.wasm",
    "https://plugins.dprint.dev/markdown-0.24.0.wasm"
  ]
}
